{
  "name": "justinsurance-support-desk-work-sample",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start": "node src/server.mjs",
    "provider": "node src/mock-provider.mjs",
    "test": "node --test test/*.test.mjs",
    "event": "node src/replay-event.mjs",
    "before-after": "node --no-warnings scripts/before-after/run.mjs",
    "graph": "node --no-warnings scripts/graph/build-graph.mjs",
    "docker:up": "docker compose up -d --build",
    "docker:down": "docker compose down",
    "coverage": "node --test --experimental-test-coverage --test-coverage-include=src/** --test-coverage-exclude=src/mock-provider.mjs --test-coverage-exclude=src/replay-event.mjs --test-coverage-lines=90 --test-coverage-branches=80 --test-coverage-functions=90 test/*.test.mjs"
  }
}
